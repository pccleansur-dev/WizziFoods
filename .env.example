APP_ENV=development
LOG_LEVEL=debug
API_PORT=3001
API_METRICS_PORT=9464
DATABASE_URL=postgresql://authenticator.replace-with-pooler-tenant:replace-with-local-password@localhost:54322/postgres
STAFF_PIN_PEPPER=replace-with-at-least-32-random-characters
# Optional. 32 random bytes in base64 (openssl rand -base64 32). Without it the
# API refuses to store payment provider credentials.
PAYMENT_SECRET_KEY=
SUPABASE_URL=http://localhost:18000
SUPABASE_SECRET_KEY=sb_secret_replace-with-local-key
ADMIN_INVITE_REDIRECT_URL=http://localhost:3000/auth/callback?next=/acceso/continuar
PLATFORM_BASE_DOMAIN=plataforma.test
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:18000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-local-key
WORKER_HEARTBEAT_MS=60000
WORKER_METRICS_PORT=9465
WORKER_POLL_MS=1000
WORKER_VISIBILITY_TIMEOUT_SECONDS=120
WEB_METRICS_PORT=9466

# Optional. Anthropic API key for the automatic catalog translation.
ANTHROPIC_API_KEY=

# Optional. Diner login with Google (T28). off | fake | live. `fake` is a simulated
# Google for development and tests and is refused in production.
DINER_AUTH_MODE=off
# 32+ random characters each; only needed when the mode is fake or live.
DINER_AUTH_STATE_SECRET=
DINER_SUB_PEPPER=
# live only: Google OAuth client and its HTTPS callback
# (https://<api>/v1/diner-auth/google/callback).
GOOGLE_DINER_CLIENT_ID=
GOOGLE_DINER_CLIENT_SECRET=
DINER_AUTH_REDIRECT_URI=
