{
  "name": "@platform/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env ./node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "lint": "eslint src",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@platform/config": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/database": "workspace:*",
    "@platform/observability": "workspace:*",
    "@supabase/supabase-js": "2.90.1",
    "read-excel-file": "9.3.12",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
