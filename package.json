{
  "name": "la-plataforma",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security:secrets",
    "infra:setup": "tsx packages/infra/src/setup-supabase.ts",
    "infra:up": "pnpm infra:setup && docker compose --project-directory infra/supabase --env-file infra/supabase/.env -f infra/supabase/docker-compose.yml -f infra/supabase/docker-compose.local.yml up -d --wait",
    "infra:down": "docker compose --project-directory infra/supabase --env-file infra/supabase/.env -f infra/supabase/docker-compose.yml -f infra/supabase/docker-compose.local.yml down",
    "infra:status": "docker compose --project-directory infra/supabase --env-file infra/supabase/.env -f infra/supabase/docker-compose.yml -f infra/supabase/docker-compose.local.yml ps",
    "demo:up": "tsx packages/infra/src/demo-onboarding.ts up",
    "demo:totp": "tsx packages/infra/src/demo-onboarding.ts totp",
    "demo:api": "tsx packages/infra/src/demo-onboarding.ts api",
    "demo:down": "tsx packages/infra/src/demo-onboarding.ts down",
    "demo:reset": "tsx packages/infra/src/demo-onboarding.ts reset",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:production": "tsx e2e/build-production.ts && playwright test -c e2e/playwright.production.config.ts",
    "security:secrets": "tsx packages/infra/src/secret-scan.ts",
    "security:gate": "tsx packages/infra/src/security-gate.ts",
    "load:smoke": "tsx e2e/load-smoke.ts",
    "deploy:env": "tsx packages/infra/src/production-env.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
