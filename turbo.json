{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "APP_ENV",
        "LOG_LEVEL",
        "WEB_METRICS_PORT",
        "API_PORT",
        "API_METRICS_PORT",
        "WORKER_HEARTBEAT_MS",
        "WORKER_METRICS_PORT",
        "WORKER_POLL_MS",
        "WORKER_VISIBILITY_TIMEOUT_SECONDS"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
